# MediKiosk Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# Environment Mode ("development" | "production" | "test")
APP_ENV=development

# Hackathon / Demo OTP Display (Development mode only)
# When true and APP_ENV=development, returns demo_otp in send-otp response for on-screen display
# MUST be false in production (enforced at startup)
SHOW_DEMO_OTP=true

# OTP Gateway & Policy Settings
OTP_MODE=sms
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Security & Cryptography
# In production, must be at least 32 cryptographically random characters
SECRET_KEY=replace_with_secure_random_secret_at_least_32_characters

# Transport Security (Set true in production to force HTTPS redirection)
ENFORCE_HTTPS=false

# Allowed CORS Origins (Comma-separated exact origins, NO wildcards in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=sqlite:///./medikiosk.db

# API Settings
AI_PROVIDER=mock # mock | openai | gemini

# External AI Keys (Optional when using mock adapters)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Bhashini / AI4Bharat Config (Optional)
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here

# SMS Gateway Configs
SMS_API_KEY=your_sms_gateway_api_key_here
SMS_SENDER_ID=MEDKSK
SMS_TEMPLATE_ID=your_template_id_here

# ABDM Integration (Configurable - Set True only when certified sandbox credentials connected)
ABDM_CONNECTED=false
