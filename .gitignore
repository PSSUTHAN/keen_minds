# ==========================================
# MediKiosk - Git Ignore
# ==========================================

# ---------- Node / React ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/
.vite/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ---------- Python / FastAPI ----------
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
*.egg
*.egg-info/
dist/
build/
.eggs/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---------- FastAPI / Application ----------
*.log
logs/

# Local database files
*.db
*.sqlite
*.sqlite3

# ---------- PostgreSQL ----------
# Do not commit database dumps
*.sql.gz
*.dump
*.backup

# ---------- Docker ----------
# Local Docker override files
docker-compose.override.yml

# Docker environment files
.env.docker

# ---------- IDE / Editors ----------
.vscode/
.idea/
*.swp
*.swo
*~

# VS Code local settings
.vscode/settings.json

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Secrets ----------
*.pem
*.key
*.crt
*.p12
*.pfx

# API keys / credentials
secrets/
credentials/
*.secret

# ---------- Uploads ----------
uploads/
media/
static/uploads/

# ---------- Temporary files ----------
tmp/
temp/
*.tmp
*.temp

# ---------- Cache ----------
.cache/
.parcel-cache/
.eslintcache

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Generated files ----------
*.generated.*

